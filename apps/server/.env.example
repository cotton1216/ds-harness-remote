DSH_SERVER_ACCOUNT=owner@example.com
DSH_SERVER_PASSWORD=replace-with-a-long-random-password
DSH_SERVER_HOST=127.0.0.1
DSH_SERVER_PORT=8080
# Must match the browser origin (scheme, hostname, port); use your HTTPS domain behind a proxy.
DSH_SERVER_PUBLIC_URL=http://localhost:8080
DSH_SERVER_DATA_FILE=./data/state.json

# Optional: comma-separated trusted reverse-proxy peer IPs. Leave empty (default)
# to disable, so X-Forwarded-For is always ignored and limits use the socket peer.
# Only bare IPv4/IPv6 literals are accepted: ports, CIDR ranges and hostnames
# make the Server fail at startup. In Docker use the proxy container/gateway IP
# as seen from the Server container, not 127.0.0.1 (which is the Server itself).
# The proxy must overwrite X-Forwarded-For with one IP, and the backend must not
# be reachable directly from the public internet.
DSH_SERVER_TRUSTED_PROXY_IPS=

# Optional: WebSocket hello handshake timeout in milliseconds (1000-60000, default: 5000).
# Values outside the allowed range are ignored with a warning and replaced by the default.
# Increase this value (e.g. 10000-15000) if mobile clients on high-latency cellular networks
# experience frequent handshake timeout disconnects.
DSH_SERVER_HELLO_TIMEOUT_MS=5000

# Optional: WebSocket control channel heartbeat interval in milliseconds (5000-120000, default: 25000).
DSH_SERVER_HEARTBEAT_INTERVAL_MS=25000

# Optional: WebSocket heartbeat disconnection threshold in milliseconds (default: 75000, max: 600000).
# Must be at least twice the heartbeat interval (>= HEARTBEAT_INTERVAL_MS * 2).
DSH_SERVER_HEARTBEAT_DISCONNECT_MS=75000

# Optional: grace period in milliseconds before a half-closed WebSocket is force-terminated
# (100-10000, default: 1000). Only raise this if slow clients need longer to finish the close handshake.
DSH_SERVER_FORCE_TERMINATE_GRACE_MS=1000

# Optional: structured logging level ('debug' | 'info' | 'warn' | 'error' | 'silent', default: 'info').
DSH_SERVER_LOG_LEVEL=info

# Optional ICE configuration for WebRTC (LAN / P2P / TURN). Leave STUN/TURN empty
# to keep Relay-only behavior; Clients automatically fall back to Relay when a
# WebRTC path is unavailable.
# STUN and TURN URLs are comma-separated and must be reachable by Host/Client:
#   DSH_SERVER_STUN_URLS=stun:coturn.example.com:3478
#   DSH_SERVER_TURN_URLS=turn:coturn.example.com:3478?transport=udp,turns:coturn.example.com:5349
# TURN requires either a coturn deployment using the REST API shared secret
# (static-auth-secret) — the Server then issues short-lived credentials and
# never exposes the secret itself — or a static username/password pair for TURN
# deployments that cannot use a shared secret. Set SECRET or USERNAME+PASSWORD,
# never both; TURN_URLS is required with either.
#   DSH_SERVER_TURN_USERNAME=remote
#   DSH_SERVER_TURN_PASSWORD=replace-with-a-long-random-password
DSH_SERVER_STUN_URLS=
DSH_SERVER_TURN_URLS=
DSH_SERVER_TURN_SECRET=
DSH_SERVER_TURN_USERNAME=
DSH_SERVER_TURN_PASSWORD=
# TURN credential lifetime in seconds (60-3600, default 300; short-lived only).
DSH_SERVER_TURN_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# Optional: standard OIDC sign-in (IAM authorization code + PKCE).
#
# All three values must be non-empty for the route to be registered; if any is
# missing, POST /api/v1/auth/iam/oidc returns 404 (see oidcConfigFromEnv).
# The Server does NOT load .env by itself: start it with
# `node --env-file=.env dist/main.js`, or inject the variables through the
# container runtime / process manager.
#
#   DSH_IAM_OIDC_ISSUER         Issuer base without a trailing slash. It must
#                               serve /.well-known/openid-configuration, and the
#                               advertised token_endpoint / jwks_uri must start
#                               with this exact issuer (foreign endpoints are
#                               rejected so auth codes cannot leak elsewhere).
#   DSH_IAM_OIDC_CLIENT_ID      Must match the client id registered with IAM and
#                               the DSH_IAM_OIDC_CLIENT_ID dart-define baked
#                               into the mobile app.
#   DSH_IAM_OIDC_CLIENT_SECRET  SERVER SIDE ONLY. Never put it in the mobile
#                               app, a dart-define, source control, or a log.
#
# Mobile-side prerequisites (build-time constants, not Server settings):
#   * Register dshgo://auth/callback as the allowed redirect_uri in IAM. It
#     must match EXACTLY: no extra query string, no trailing slash. Open
#     /api/oidc/authorize in the SYSTEM browser (iOS ASWebAuthenticationSession
#     / Android Custom Tabs), not an in-app WebView, and handle both deep-link
#     callbacks: ?code=...&state=... and ?error=access_denied&state=...
#     The current mobile build still uses an in-app WebView + loopback
#     redirect and must be updated before sign-in works; see
#     docs/iam-oidc-integration.md §8.2 for the full gap list.
#   * Build the app with --dart-define=DSH_IAM_OIDC_ISSUER=<same issuer> and
#     --dart-define=DSH_IAM_OIDC_CLIENT_ID=<same client id>. An empty client id
#     makes the app show "not configured" instead of the sign-in page.
#   * Point the app at this Server with --dart-define=DSH_DEFAULT_RELAY=<url>
#     (default https://dsh.r2049.cn) or set the relay URL in-app.
#
# Enabling OIDC alone does NOT remove the local account: unless DSH_IAM_BASE is
# also configured, DSH_SERVER_ACCOUNT / DSH_SERVER_PASSWORD above must stay
# populated or startup fails with "At least one DSH_SERVER account is required."
DSH_IAM_OIDC_ISSUER=
DSH_IAM_OIDC_CLIENT_ID=
DSH_IAM_OIDC_CLIENT_SECRET=
