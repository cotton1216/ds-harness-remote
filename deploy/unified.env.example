# 中继服务端环境变量模板
#
# 用法（在目标机上）：
#   cp unified.env.example /root/dsh-relay-multi/unified.env
#   # 填入真实值，然后：
#   chmod 600 /root/dsh-relay-multi/unified.env
#
# 该文件通过 `docker run --env-file` 注入。不要改用 `-e KEY=VALUE`：
# 那样密钥会出现在 shell 历史、进程列表和 `docker inspect` 的可读输出里。
# 线上容器当前就是靠这个文件注入的，见 docs/server-deployment.md §5。

# ── 服务基础 ──────────────────────────────────────────────────────
NODE_ENV=production
DSH_SERVER_HOST=0.0.0.0
DSH_SERVER_PORT=8080
DSH_SERVER_DATA_FILE=/data/state.json
DSH_SERVER_LOG_LEVEL=info

# 对外基址。中继用它生成注册码/回调里的绝对链接，必须与 nginx 实际暴露的
# scheme + host + port 一致，否则客户端拿到的地址连不上。
DSH_SERVER_PUBLIC_URL=https://<RELAY_HOST>:8443

# 账号表：内联 JSON 数组，结构见 accounts.json.example。
# 容器内没有单独的账号文件，整份表走这个变量。
DSH_SERVER_ACCOUNTS_JSON=[{"account":"<NAME>","password":"<PASSWORD>"}]

# 允许设备换挂账号（重装 App 后新旧 accountId 关联）。多端联调需要 1。
DSH_ALLOW_DEVICE_REBIND=1

# 授权码有效期，毫秒。1800000 = 30 分钟。
DSH_REGISTRATION_CODE_TTL_MS=1800000

# ── IAM / OIDC ────────────────────────────────────────────────────
# 三项缺一，客户端会收到「中继尚未配置单点登录」。
# DSH_IAM_OIDC_ISSUER 显式设置后，服务端才启用统一身份派生
# （iam:<sha256(issuer+subject)>），这是多端同账号的前提。
DSH_IAM_BASE=https://<IAM_HOST>
DSH_IAM_OIDC_ISSUER=https://<IAM_HOST>/iam
DSH_IAM_OIDC_CLIENT_ID=<CLIENT_ID>

# 客户端密钥。**只写在目标机本地的这个文件里**（600）：
# 不提交进仓库、不写进文档、不打印、不进命令行参数。
DSH_IAM_OIDC_CLIENT_SECRET=<CLIENT_SECRET>
