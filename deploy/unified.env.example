# 中继服务端环境变量模板
#
# 用法（在目标机上）：
#   cp unified.env.example /root/dsh-relay-multi/unified.env
#   # 填入真实值，然后：
#   chmod 600 /root/dsh-relay-multi/unified.env
#
# 该文件通过 `docker run --env-file` 注入。不要改用 `-e KEY=VALUE`：
# 那样密钥会出现在 shell 历史、进程列表和 `docker inspect` 的可读输出里。
# 线上容器当前就是靠这个文件注入的，见 docs/server-deployment.md §5。

# ── 服务基础 ──────────────────────────────────────────────────────
NODE_ENV=production
DSH_SERVER_HOST=0.0.0.0
DSH_SERVER_PORT=8080
DSH_SERVER_DATA_FILE=/data/state.json
DSH_SERVER_LOG_LEVEL=info

# 对外基址。中继用它生成注册码/回调里的绝对链接，必须与 nginx 实际暴露的
# scheme + host + port 一致，否则客户端拿到的地址连不上。
DSH_SERVER_PUBLIC_URL=https://<RELAY_HOST>:8443

# 账号表：内联 JSON 数组，结构见 accounts.json.example。
# 容器内没有单独的账号文件，整份表走这个变量。
DSH_SERVER_ACCOUNTS_JSON=[{"account":"<NAME>","password":"<PASSWORD>"}]

# 允许设备换挂账号（重装 App 后新旧 accountId 关联）。多端联调需要 1。
DSH_ALLOW_DEVICE_REBIND=1

# 授权码有效期，毫秒。1800000 = 30 分钟。
DSH_REGISTRATION_CODE_TTL_MS=1800000

# ── 身份 / OIDC ───────────────────────────────────────────────────
# 三项缺一，客户端会收到「中继尚未配置单点登录」。
# DSH_IAM_OIDC_ISSUER 显式设置后，服务端才启用统一身份派生
# （iam:<sha256(issuer+subject)>），这是多端同账号的前提。
#
# DSH_IDENTITY_BASE 是**身份服务**（AI-Server）基址，用来读 /api/v1/user/profile。
# 它不是 IAM 的地址：现网两者同源，所以历史上被误写成 DSH_IAM_BASE，名字留着会被
# 当成 IAM 去排查。旧名仍被接受，但启动时会打一条 deprecation 警告。
DSH_IDENTITY_BASE=https://<AI_SERVER_HOST>
DSH_IAM_OIDC_ISSUER=https://<IAM_HOST>/iam
DSH_IAM_OIDC_CLIENT_ID=<CLIENT_ID>

# 客户端密钥。**只写在目标机本地的这个文件里**（600）：
# 不提交进仓库、不写进文档、不打印、不进命令行参数。
DSH_IAM_OIDC_CLIENT_SECRET=<CLIENT_SECRET>

# ── Web 管理台单点登录（可选）──────────────────────────────────
# 浏览器登录的回跳地址。设置后 /app/login 出现「使用如意 AI 账号登录」，
# 同时这个值会被加入换票白名单（手机端的 dshgo://auth/callback 始终保留）。
# 必须与 IAM 后台登记的 redirect_uri **逐字一致**，不带 query 与尾部斜杠。
# 留空则 Web 端只保留本地账号密码登录。
DSH_WEB_REDIRECT_URI=https://<RELAY_HOST>:8443/app/callback

# 授权端点。不设时按 OIDC discovery 发现，发现失败回退到
# ${DSH_IAM_OIDC_ISSUER}/api/oidc/authorize；写死可让登录页不依赖任何网络请求。
# 必须落在 DSH_IAM_OIDC_ISSUER 之下，否则该行被忽略。
# DSH_IAM_OIDC_AUTHORIZE_ENDPOINT=https://<IAM_HOST>/iam/api/oidc/authorize

# ── 如意账号登录（AI-Server 桌面授权，可选）─────────────────────
# 与上面的 IAM OIDC 并列的另一条入口：换的是 AI-Server 的 access_token，
# 没有 client_secret，客户端是公开客户端 + PKCE。两条入口落同一个账号主键，
# 所以可以并存、也可以只开这一套（此时 DSH_IAM_OIDC_* 可以全留空）。
#
# DSH_AISERVER_BASE 是 AI-Server 部署根（含反代前缀，不带尾部斜杠）。
# 三件套齐全才启用；缺一个就当作未配置，登录页不出现该按钮。
DSH_AISERVER_BASE=https://<AI_SERVER_HOST>/aiserver
DSH_AISERVER_CLIENT_ID=dsh-remote-web
DSH_AISERVER_WEB_REDIRECT_URI=https://<RELAY_HOST>:8443/app/callback

# 手机端是**可选的第二组**登记，必须成对出现（半填会直接拒绝启动）。
# client_id 与回调地址都在 AI-Server 的 desktop_redirect_whitelist 表里逐字匹配；
# 迁移 252 之后同一个 client_id 可以挂多条回调（新旧 scheme 并存）。
# 现网登记：ruyi-android -> ruyiai://auth3/callback
# DSH_AISERVER_MOBILE_CLIENT_ID=ruyi-android
# DSH_AISERVER_MOBILE_REDIRECT_URI=ruyiai://auth3/callback
